# Settings for SecurityX.app. Copy to ~/.securityx/app.env and edit.
# Plain KEY=value lines, no quotes; read each time the app starts.

# The folder the scan form offers.
SECURITYX_ROOT=/Users/you/Projects

# The domain monitor. With only the address set, the admin token is read from
# this checkout's monitor/.secrets.production. Or set SECURITYX_ADMIN_TOKEN here.
#SECURITYX_MONITOR_URL=https://securityx-monitor.example.workers.dev

# A model for Explain, Summarise and Ask (see the README's Local model section).
#SECURITYX_LLM_URL=http://localhost:11434
#SECURITYX_LLM_MODEL=qwen3:8b

# Private GitHub repositories.
#SECURITYX_GITHUB_TOKEN=
