#!/bin/sh
# Refuses a commit that would add a secret.
# Enabled by `npm run setup`, or: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed, so staged changes were not checked for secrets (brew install gitleaks)" >&2
	exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
